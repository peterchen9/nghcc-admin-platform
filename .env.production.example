# Production environment template.
# Copy to .env.production on the target host and fill every REQUIRED value.
# This example is not a deploy approval and must not contain real secrets.

APP_NAME=nghcc-admin-platform
APP_ENV=production
APP_PORT=26001
# APP_TLS_PORT=26443

COMPOSE_PROJECT_NAME=nghcc-admin-platform-production

# REQUIRED: must be unique, high entropy, and managed as a secret.
# Must not be empty, "change_me", "local-dev-only-secret", or any shared placeholder.
DJANGO_SECRET_KEY=REQUIRED_SET_UNIQUE_PRODUCTION_SECRET

# REQUIRED: production must keep debug disabled.
DJANGO_DEBUG=False
DEBUG=False

# REQUIRED: set exact production hosts/domains. Do not use wildcard values.
# Examples:
# DJANGO_ALLOWED_HOSTS=app.example.org
# DJANGO_ALLOWED_HOSTS=app.example.org,192.0.2.10
DJANGO_ALLOWED_HOSTS=REQUIRED_SET_FINAL_HOSTS

# REQUIRED when CSRF is enabled. Include scheme, hostname, and port when non-standard.
# Examples:
# CSRF_TRUSTED_ORIGINS=https://app.example.org
# CSRF_TRUSTED_ORIGINS=https://app.example.org,http://192.0.2.10:26001
CSRF_TRUSTED_ORIGINS=REQUIRED_SET_FINAL_ORIGINS

# REQUIRED: production target is CSRF enabled. Do not disable without a signed exception.
ENABLE_CSRF_PROTECTION=True
ENABLE_MENU_PERMISSION_ENFORCEMENT=False

# REQUIRED: keep off unless API permission enforcement is separately authorized.
API_PERMISSION_MODE=off

# REQUIRED: set according to the final HTTPS decision.
# Use True when users access the site through HTTPS.
# Use False only for an explicitly approved temporary HTTP-only environment.
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SESSION_COOKIE_HTTPONLY=True
CSRF_COOKIE_HTTPONLY=False
SECURE_CONTENT_TYPE_NOSNIFF=True
X_FRAME_OPTIONS=SAMEORIGIN

# REQUIRED: database values must be explicit and non-default.
DB_HOST=db
DB_PORT=3306
DB_NAME=REQUIRED_SET_DB_NAME
DB_USER=REQUIRED_SET_DB_USER
DB_PASSWORD=REQUIRED_SET_DB_PASSWORD
DB_ROOT_PASSWORD=REQUIRED_SET_DB_ROOT_PASSWORD

# DB_EXTERNAL_PORT is intentionally omitted for production. Do not publish MySQL.

UPLOAD_DIR=/app/media
UPLOAD_MAX_SIZE_MB=10
UPLOAD_ALLOWED_EXTENSIONS=jpg,jpeg,png,gif,pdf,doc,docx,xls,xlsx
UPLOAD_STRICT_MIME_CHECK=False
