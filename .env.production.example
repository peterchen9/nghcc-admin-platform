# Production environment template for compose/config review.
# Copy to .env.production only after explicit phase approval and replace every
# UNUSABLE_REPLACE_ME_* value. This example is intentionally not deployable.
# It must not contain real secrets and is not a production deploy approval.

APP_NAME=nghcc-admin-platform
APP_ENV=production

# HTTP entrypoint. Keep HTTP only for an explicitly approved temporary
# internal-only production exception. Prefer HTTPS for real user access.
APP_PORT=26001

# HTTPS entrypoint. Enable only after TLS certificates, final hostnames, and
# secure-cookie policy are approved.
# APP_TLS_PORT=26443

COMPOSE_PROJECT_NAME=nghcc-admin-platform-production

# REQUIRED SECRET: must be unique, high entropy, and managed outside Git.
# Must not be empty, "change_me", "local-dev-only-secret", this placeholder,
# or any value shared with local/staging.
DJANGO_SECRET_KEY=UNUSABLE_REPLACE_ME_UNIQUE_PRODUCTION_SECRET

# REQUIRED: production must keep debug disabled.
DJANGO_DEBUG=False
DEBUG=False

# REQUIRED HOST POLICY: set exact approved production hosts/domains only.
# Do not use "*", broad wildcards, localhost for browser traffic, or unapproved
# raw IPs. Include an IP only if raw-IP production access is explicitly approved.
# Examples:
# DJANGO_ALLOWED_HOSTS=app.example.org
# DJANGO_ALLOWED_HOSTS=app.example.org,192.0.2.10
DJANGO_ALLOWED_HOSTS=UNUSABLE_REPLACE_ME_FINAL_HOSTS

# REQUIRED ORIGIN POLICY: required when CSRF is enabled.
# Include exact scheme, host, and non-standard port. Prefer HTTPS origins.
# HTTP origins are allowed only for an explicitly approved temporary internal
# HTTP-only exception and must match the approved host/IP exactly.
# Examples:
# CSRF_TRUSTED_ORIGINS=https://app.example.org
# CSRF_TRUSTED_ORIGINS=https://app.example.org,http://192.0.2.10:26001
CSRF_TRUSTED_ORIGINS=UNUSABLE_REPLACE_ME_FINAL_ORIGINS

# REQUIRED CSRF POLICY: production target is CSRF enabled.
# Do not set False without a documented and approved exception.
ENABLE_CSRF_PROTECTION=True

# Menu enforcement is not finalized by this env phase. Keep False until a
# separate permission-governance phase approves production enforcement.
ENABLE_MENU_PERMISSION_ENFORCEMENT=False

# REQUIRED API PERMISSION POLICY:
# - off: approved default and rollback lever.
# - report-only: local/staging-like review only unless separately approved.
# - enforce: production NO-GO without explicit approval, scope review, rollback
#   plan, and security verification.
API_PERMISSION_MODE=off

# REQUIRED COOKIE/TRANSPORT POLICY:
# Use True when users access the site through HTTPS. Use False only for an
# explicitly approved temporary HTTP-only internal environment. Cookie settings
# must match the final browser URL, not just the container network.
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SESSION_COOKIE_HTTPONLY=True
CSRF_COOKIE_HTTPONLY=False
SECURE_CONTENT_TYPE_NOSNIFF=True
X_FRAME_OPTIONS=SAMEORIGIN

# REQUIRED DB POLICY: database values must be explicit and non-default.
# DB_HOST must remain the internal compose service name unless a separate
# approved architecture says otherwise. Do not publish MySQL in production.
DB_ENGINE=django.db.backends.mysql
DB_HOST=db
DB_PORT=3306
DB_NAME=UNUSABLE_REPLACE_ME_DB_NAME
DB_USER=UNUSABLE_REPLACE_ME_DB_USER
DB_PASSWORD=UNUSABLE_REPLACE_ME_DB_PASSWORD
DB_ROOT_PASSWORD=UNUSABLE_REPLACE_ME_DB_ROOT_PASSWORD

# DB_EXTERNAL_PORT is intentionally omitted for production. Do not publish MySQL.

# REQUIRED UPLOAD POLICY: keep upload limits explicit. MIME strict mode remains
# False until production validation confirms accepted legacy upload types.
UPLOAD_DIR=/app/media
UPLOAD_MAX_SIZE_MB=10
UPLOAD_ALLOWED_EXTENSIONS=jpg,jpeg,png,gif,pdf,doc,docx,xls,xlsx
UPLOAD_STRICT_MIME_CHECK=False
