# Example reverse proxy for nghcc-admin-platform.
# Copy this file to a deployment-specific nginx config and replace server_name.
# Do not treat this file as an approved production domain or TLS certificate config.

upstream nghcc_admin_web {
    server web:8000;
}

server {
    listen 80;
    server_name _;

    client_max_body_size 20m;
    autoindex off;

    add_header X-Content-Type-Options "nosniff" always;

    # For HTTPS production, terminate TLS here or at an upstream load balancer.
    # Example only:
    # listen 443 ssl http2;
    # ssl_certificate /etc/nginx/certs/fullchain.pem;
    # ssl_certificate_key /etc/nginx/certs/privkey.pem;
    #
    # If TLS is terminated before this container, preserve X-Forwarded-Proto
    # and set Django secure-cookie env vars according to the final HTTPS decision.

    location /static/ {
        alias /var/www/nghcc-admin/static/;
        autoindex off;
        access_log off;
        expires 30d;
        add_header Cache-Control "public, max-age=2592000";
        try_files $uri =404;
    }

    location /media/ {
        alias /var/www/nghcc-admin/media/;
        autoindex off;
        expires 1h;
        add_header Cache-Control "private, max-age=3600";
        try_files $uri =404;
    }

    location / {
        proxy_pass http://nghcc_admin_web;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_redirect off;
        proxy_read_timeout 60s;
        proxy_connect_timeout 10s;
    }
}
